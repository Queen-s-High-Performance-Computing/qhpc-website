# Changes to files that will be ignored by git
# Uses glob pattern. Ex: '*.exe' ignores all files ending with '.exe'.
*.exe
*.bin
.DS_Store
.codex
perf.*
*.log

# Changes to folders that will be ignored by git.
# Format: [folder_name]/
.vscode/
install/
build/
log/

# Next.js dependencies and generated files.
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo
